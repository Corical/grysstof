# Grysstof. Copy to .env and fill in; .env is gitignored. One instance per env file:
# deno task migrate:env, then deno task serve:env. For a second instance copy to another
# file and run: deno run --env-file=.env.other --allow-net --allow-env --allow-read --allow-write entry/serve.ts
OB_MEMORY=postgres
OB_PG_URL=postgres://postgres:CHANGE_ME@localhost:55432/grysstof?sslmode=disable
OB_TENANT=default
EMBEDDING_API_BASE=http://localhost:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
CHAT_API_BASE=https://api.anthropic.com/v1
CHAT_API_KEY=sk-ant-CHANGE_ME
CHAT_MODEL=claude-haiku-4-5-20251001
MCP_ACCESS_KEY=CHANGE_ME
PORT=8787
